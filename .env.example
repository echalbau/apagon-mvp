# --- Telegram: cuenta de USUARIO para leer canales públicos (my.telegram.org) ---
# Usa una cuenta dedicada al proyecto, no tu cuenta personal.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Ruta del archivo de sesión de Telethon (sin extensión)
TELEGRAM_SESSION=data/telethon

# --- Telegram: BOT para enviar alertas (BotFather) ---
TELEGRAM_BOT_TOKEN=
# 1 = imprime las alertas en consola en lugar de enviarlas
APAGON_DRY_RUN=1

# --- Privacidad: sal para el hash de autores. Cámbiala y no la publiques. ---
APAGON_AUTHOR_SALT=cambia-esta-sal

# --- Rutas ---
APAGON_DB_PATH=data/apagon.db
APAGON_MODEL_DIR=models

# --- Parámetros del pipeline ---
APAGON_MIN_AUTHORS=3          # autores distintos por región-hora para etiquetar una falla
APAGON_HORIZON_H=6            # horizonte del pronóstico (horas)
APAGON_DEFAULT_THRESHOLD=0.6  # probabilidad mínima por defecto para alertar
APAGON_ALERT_COOLDOWN_H=3     # horas sin repetir la misma alerta al mismo chat
APAGON_DETECT_WINDOW_MIN=60   # ventana de la detección inmediata (minutos)
APAGON_UTC_OFFSET_H=-4        # hora de Venezuela
